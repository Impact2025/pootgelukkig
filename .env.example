# ================================
# PootGelukkig — Omgevingsvariabelen
# Kopieer dit bestand naar .env.local
# ================================

# --- DATABASE (Neon PostgreSQL) ---
# Maak gratis account op neon.tech
# Klik "New Project" > "pootgelukkig"
# Kopieer de connection strings
DATABASE_URL="postgresql://gebruiker:wachtwoord@ep-xxx.eu-central-1.aws.neon.tech/pootgelukkig?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://gebruiker:wachtwoord@ep-xxx.eu-central-1.aws.neon.tech/pootgelukkig?sslmode=require"

# --- AUTHENTICATIE (NextAuth) ---
# Genereer met: openssl rand -base64 32
NEXTAUTH_SECRET="vervang-dit-met-een-veilig-geheim"
NEXTAUTH_URL="http://localhost:3000"

# --- AI (OpenRouter) ---
# Haal op via openrouter.ai/keys
# Ondersteunt Claude, GPT-4o, Gemini en meer
OPENROUTER_API_KEY="sk-or-v1-..."

# --- VERCEL BLOB (Foto uploads) ---
# Automatisch beschikbaar na "vercel link"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- E-MAIL (Resend) ---
# Haal op via resend.com/api-keys. Zonder key worden mails alleen gelogd (niet verzonden).
RESEND_API_KEY="re_..."

# --- CRON (Vercel Cron jobs) ---
# Geheim waarmee cron-routes zichzelf authenticeren (Authorization: Bearer <secret>)
# Genereer met: openssl rand -base64 32
CRON_SECRET="vervang-dit-met-een-veilig-geheim"

# Ontvanger van de management-digests (dag + maand). Default in code: v.munster@weareimpact.nl
MANAGEMENT_EMAIL="v.munster@weareimpact.nl"

# --- APP CONFIGURATIE ---
# Canonieke basis-URL. In productie MOET dit de primaire host zijn (www), zodat
# canonical-tags, sitemap.xml en robots.txt naar niet-redirectende URL's wijzen.
# Prod: https://www.pootgelukkig.nl · lokaal: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PootGelukkig"

# --- DEMO VIDEO (asielen werving) ---
# YouTube-link naar de 90s demo-video voor de UitnodigingAsielV2 mail-template
# DEMO_VIDEO_URL="https://www.youtube.com/watch?v=..."
