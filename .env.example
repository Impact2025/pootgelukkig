# ================================
# ImpactOS — Omgevingsvariabelen
# Kopieer dit bestand naar .env.local
# ================================

# --- DATABASE (Neon PostgreSQL) ---
# Maak gratis account op neon.tech
# Klik "New Project" > "impactos"
# Kopieer de connection strings
DATABASE_URL="postgresql://gebruiker:wachtwoord@ep-xxx.eu-central-1.aws.neon.tech/impactos?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://gebruiker:wachtwoord@ep-xxx.eu-central-1.aws.neon.tech/impactos?sslmode=require"

# --- AUTHENTICATIE (NextAuth) ---
# Genereer met: openssl rand -base64 32
NEXTAUTH_SECRET="vervang-dit-met-een-veilig-geheim"
NEXTAUTH_URL="http://localhost:3000"

# --- AI (OpenRouter) ---
# Haal op via openrouter.ai/keys
# Ondersteunt Claude, GPT-4o, Gemini en meer
OPENROUTER_API_KEY="sk-or-v1-..."

# --- VERCEL BLOB (Foto uploads) ---
# Automatisch beschikbaar na "vercel link"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- E-MAIL (Resend) ---
# Haal op via resend.com/api-keys. Zonder key worden mails alleen gelogd (niet verzonden).
RESEND_API_KEY="re_..."

# --- CRON (Vercel Cron jobs) ---
# Geheim waarmee cron-routes zichzelf authenticeren (Authorization: Bearer <secret>)
# Genereer met: openssl rand -base64 32
CRON_SECRET="vervang-dit-met-een-veilig-geheim"

# Ontvanger van de management-digests (dag + maand). Default in code: v.munster@weareimpact.nl
MANAGEMENT_EMAIL="v.munster@weareimpact.nl"

# --- APP CONFIGURATIE ---
# Canonieke basis-URL. In productie MOET dit de primaire host zijn (www), zodat
# canonical-tags, sitemap.xml en robots.txt naar niet-redirectende URL's wijzen.
# Prod: https://www.impactos.nl · lokaal: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ImpactOS"

# --- DEMO VIDEO (asielen werving) ---
# YouTube-link naar de 90s demo-video voor de UitnodigingAsielV2 mail-template
# DEMO_VIDEO_URL="https://www.youtube.com/watch?v=..."

# --- AGENDA-KOPPELING: MICROSOFT (Outlook/Microsoft 365) ---
# App-registratie aanmaken op https://portal.azure.com → App registrations → New registration.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/integraties/microsoft/callback
# API-permissions (delegated): Calendars.Read, offline_access, User.Read
# Zonder deze twee waarden blijft "Koppel Outlook-agenda" in Instellingen uitgeschakeld.
# MICROSOFT_CLIENT_ID="..."
# MICROSOFT_CLIENT_SECRET="..."

# --- AGENDA-KOPPELING: GOOGLE (Google Calendar) ---
# OAuth-client aanmaken op https://console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/integraties/google/callback
# Scopes: https://www.googleapis.com/auth/calendar.readonly
# Zonder deze twee waarden blijft "Koppel Google-agenda" in Instellingen uitgeschakeld.
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."

# Versleutelingssleutel voor opgeslagen OAuth-tokens (agenda-koppelingen).
# Genereer met: openssl rand -hex 32
INTEGRATIE_ENCRYPTIE_SLEUTEL="vervang-dit-met-een-veilig-geheim-64-hex-chars"
